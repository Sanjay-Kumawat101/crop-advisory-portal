[Unit]
Description=Crop Advisory Portal
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=cropapp
Group=cropapp
WorkingDirectory=/opt/{{ app_name }}/current
EnvironmentFile={{ app_config_dir }}/{{ app_name }}.env
ExecStart=/usr/bin/java -jar /opt/{{ app_name }}/current/app.war
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths={{ app_data_dir }}

[Install]
WantedBy=multi-user.target
